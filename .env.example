# WealthTrack Agent — Environment Variables
# Copy this file to .env and fill in real values

# ── Google Gemini (REQUIRED for hackathon) ────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Ollama (local fallback only — not used when GEMINI_API_KEY is set) ────────
OLLAMA_MODEL=llama3.2

# ── MCP Service URLs (Docker Compose sets these automatically) ────────────────
MCP_YAHOO_URL=http://localhost:8001
MCP_DUCKDUCKGO_URL=http://localhost:8002
MCP_FETCH_URL=http://localhost:8003
MCP_MEMORY_URL=http://localhost:8004

# ── Arize Phoenix (AI observability — MCP partner integration) ────────────────
# Option A: Arize cloud (sign up at app.phoenix.arize.com)
# PHOENIX_API_KEY=your_arize_api_key_here
# PHOENIX_HOST=https://app.phoenix.arize.com
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/v1/traces
#
# Option B: Local Phoenix (docker compose up phoenix) — no account needed
PHOENIX_HOST=http://localhost:6006
PHOENIX_ENABLED=true
PHOENIX_PROJECT=wealthtrack-agent
